# Beekeeper optional cloud features (Azure). Leave empty to stay fully offline.
# These values are only read as defaults; keys entered in Settings > AI take precedence
# and are stored encrypted with Windows DPAPI (Electron safeStorage).

# Azure AI Speech (neural STT / TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure OpenAI (chat + vision)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
